# TRACE-X Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="TRACE-X Investigative Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="tracex_super_secret_development_jwt_key_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tracex_user
POSTGRES_PASSWORD=tracex_password
POSTGRES_DB=tracex_db
# Set DATABASE_URL if preferred (defaults to sqlite for immediate local zero-dependency fallback)
DATABASE_URL=sqlite:///./tracex.db
# For PostgreSQL: postgresql+psycopg2://tracex_user:tracex_password@localhost:5432/tracex_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracex_neo4j_password
NEO4J_DATABASE=neo4j

# Google OAuth (Optional / Demo fallback)
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]
